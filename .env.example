NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT secrets - generate strong random values for real deployments
JWT_ACCESS_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change_me_too
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=10

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Used only by the admin seed script
ADMIN_SEED_EMAIL=admin@vidacare.com
ADMIN_SEED_PASSWORD=Admin@12345
ADMIN_SEED_NAME=Maya Chen

# Hours of inactivity before a "missed reading" alert is generated
MISSED_READING_HOURS=24
