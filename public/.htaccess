# ---------------------------------------------------------------------------------------------
# Rewrites: https + no "www", real pages served from disk, SPA fallback only for the admin panel.
# __ADMIN_BASE__ is replaced with the admin URL prefix (VITE_ADMIN_BASE) at build time.
# ---------------------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One canonical address: https, without www
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Admin panel: single-page app, so unknown paths load index.html
  RewriteCond %{REQUEST_URI} ^__ADMIN_BASE__(/|$)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# Anything else that does not exist is a real 404 (not a copy of the home page)
ErrorDocument 404 /404.html
DirectoryIndex index.html

# Keep the admin panel out of search results
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^__ADMIN_BASE__(/|$)" ROBOTS_NOINDEX
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=ROBOTS_NOINDEX
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Built JS/CSS have hashed file names, so they can be cached for a year
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images and fonts keep their names, so a shorter cache lets logo changes show up
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>
